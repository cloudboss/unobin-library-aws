factory: {
  description:     'Stops a managed EC2 instance after its ownership is persisted'
  imports:         { ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2' }
  library-configs: { ec2: input.aws-config }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    batch: { type: string, default: 'applied' }
  }
  data-sources: {
    image: ec2.ami {
      owners:      ['amazon']
      most-recent: true
      filters:     [{ name: 'name', values: ['al2023-ami-2023.*-kernel-*-x86_64'] }]
    }
  }
  resources: {
    vpc: ec2.vpc {
      cidr-block: '10.87.0.0/16'
    }
    subnet: ec2.subnet {
      vpc-id:     resource.vpc.vpc-id
      cidr-block: '10.87.1.0/24'
    }
    instance: ec2.instance {
      ami:           data-source.image.image-id
      instance-type: 't3.micro'
      subnet-id:     resource.subnet.id
      tags:          { unobin: 'ec2-stop-instance-it' }
    }
  }
  actions: {
    stop: ec2.stop-instance {
      @trigger:    input.batch
      instance-id: resource.instance.instance-id
    }
  }
  outputs: { instance-id: { value: resource.instance.instance-id } }
}
