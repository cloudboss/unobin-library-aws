factory: {
  imports: { iam: 'github.com/cloudboss/unobin-library-aws//service/iam' }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    metadata: { type: string }
    tags:     { type: map(string) }
  }
  library-configs: { iam: input.aws-config }
  resources: {
    provider: iam.saml-provider {
      name:                   'unobin-integration-saml-provider'
      saml-metadata-document: input.metadata
      tags:                   input.tags
    }
  }
  outputs: {
    arn:         { value: resource.provider.arn }
    name:        { value: resource.provider.name }
    uuid:        { value: resource.provider.saml-provider-uuid }
    valid-until: { value: resource.provider.valid-until }
    metadata:    { value: resource.provider.saml-metadata-document }
    tags:        { value: resource.provider.tags }
  }
}
