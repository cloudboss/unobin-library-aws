factory: {
  description: 'Creates DynamoDB backups and checks completed metadata against the cloud'
  imports: {
    dynamodb: 'github.com/cloudboss/unobin-library-aws//service/dynamodb'
    fixture:  'github.com/cloudboss/unobin-library-aws//tests/integration/fixtures/dynamodbbackup'
  }
  library-configs: { dynamodb: input.aws-config, fixture: input.aws-config }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    batch: { type: string, default: 'applied' }
  }
  resources: {
    table: dynamodb.table {
      name:         'unobin-it-create-backup'
      billing-mode: 'PAY_PER_REQUEST'
      hash-key:     'id'
      attribute:    [{ name: 'id', type: 'S' }]
    }
    cleanup: fixture.cleanup {
      table-arn:  resource.table.arn
      table-name: 'unobin-it-create-backup'
    }
  }
  actions: {
    backup: dynamodb.create-backup {
      @trigger:    input.batch
      table-name:  resource.cleanup.table-name
      backup-name: $'unobin-it-backup-{{ input.batch }}'
    }
  }
  data-sources: {
    backup: fixture.backup-check {
      backup-arn:                action.backup.backup-arn
      backup-creation-date-time: action.backup.backup-creation-date-time
      backup-size-bytes:         action.backup.backup-size-bytes
    }
  }
  outputs: {
    backup-arn:                { value: action.backup.backup-arn }
    backup-creation-date-time: { value: action.backup.backup-creation-date-time }
    backup-size-bytes:         { value: action.backup.backup-size-bytes }
    verified:                  { value: data-source.backup.verified }
  }
}
