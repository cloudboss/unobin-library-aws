factory: {
  imports:         { aws-scheduler: 'github.com/cloudboss/unobin-library-aws//service/scheduler' }
  library-configs: { aws-scheduler: {} }
  inputs: {
    tags: { type: optional(map(string)) }
  }
  resources: {
    group: aws-scheduler.schedule-group {
      name: 'unobin-it-schedule-group'
      tags: input.tags
    }
  }
  outputs: {
    arn:  { value: resource.group.arn }
    name: { value: resource.group.name }
    tags: { value: resource.group.tags }
  }
}
