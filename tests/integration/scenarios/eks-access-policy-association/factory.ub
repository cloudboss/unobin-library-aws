factory: {
  description: 'Associates an EKS access policy on an API-enabled cluster.'

  imports: {
    aws-ec2:  'github.com/cloudboss/unobin-library-aws//service/ec2'
    aws-eks:  'github.com/cloudboss/unobin-library-aws//service/eks'
    aws-iam:  'github.com/cloudboss/unobin-library-aws//service/iam'
    aws-meta: 'github.com/cloudboss/unobin-library-aws//meta'
  }

  library-configs: {
    aws-ec2:  input.aws-config
    aws-eks:  input.aws-config
    aws-iam:  input.aws-config
    aws-meta: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    scope-type: { type: string, default: 'cluster' }
    namespaces: { type: list(string), default: [] }
  }

  data-sources: {
    partition: aws-meta.partition {}
    availability-zones: aws-ec2.availability-zones {
      state: 'available'
    }
  }

  resources: {
    vpc: aws-ec2.vpc {
      cidr-block: '10.94.0.0/16'
    }
    subnet-a: aws-ec2.subnet {
      vpc-id:            resource.vpc.vpc-id
      cidr-block:        '10.94.1.0/24'
      availability-zone: data-source.availability-zones.names[0]
    }
    subnet-b: aws-ec2.subnet {
      vpc-id:            resource.vpc.vpc-id
      cidr-block:        '10.94.2.0/24'
      availability-zone: data-source.availability-zones.names[1]
    }
    cluster-role: aws-iam.role {
      role-name: 'unobin-it-eks-policy-cluster'
      assume-role-policy-document: @core.to-json(
        {
          Version: '2012-10-17'
          Statement: [
            {
              Effect:    'Allow'
              Principal: { Service: 'eks.amazonaws.com' }
              Action:    'sts:AssumeRole'
            },
          ]
        },
      )
    }
    cluster-policy: aws-iam.role-policy-attachment {
      role-name: resource.cluster-role.role-name
      policy-arn: $'''\-
        arn:{{ data-source.partition.partition }}:iam::aws:policy/AmazonEKSClusterPolicy
        '''
    }
    cluster: aws-eks.cluster {
      @depends-on:   [resource.cluster-policy]
      name:          'unobin-it-eks-policy'
      role-arn:      resource.cluster-role.arn
      access-config: { authentication-mode: 'API' }
      vpc-config: {
        subnet-ids:              [resource.subnet-a.id, resource.subnet-b.id]
        endpoint-private-access: false
        endpoint-public-access:  true
      }
    }
    principal: aws-iam.role {
      role-name: 'unobin-it-eks-policy-principal'
      assume-role-policy-document: @core.to-json(
        {
          Version: '2012-10-17'
          Statement: [
            {
              Effect:    'Allow'
              Principal: { Service: 'ec2.amazonaws.com' }
              Action:    'sts:AssumeRole'
            },
          ]
        },
      )
    }
    entry: aws-eks.access-entry {
      cluster-name:  resource.cluster.name
      principal-arn: resource.principal.arn
    }
    association: aws-eks.access-policy-association {
      cluster-name:  resource.entry.cluster-name
      principal-arn: resource.entry.principal-arn
      policy-arn: $'''\-
        arn:{{ data-source.partition.partition }}:eks::aws:cluster-access-policy/AmazonEKSViewPolicy
        '''
      access-scope: {
        type:       input.scope-type
        namespaces: input.namespaces
      }
    }
  }

  outputs: {
    cluster:       { value: resource.association.cluster-name }
    principal:     { value: resource.association.principal-arn }
    policy:        { value: resource.association.policy-arn }
    scope:         { value: resource.association.access-scope }
    associated-at: { value: resource.association.associated-at }
    modified-at:   { value: resource.association.modified-at }
  }
}
