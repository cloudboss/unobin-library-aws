factory: {
  description: '''>-
    Manages a CloudWatch metric alarm and dashboard. The update changes the alarm threshold,
    dashboard body, and dashboard tags in place. The alarm needs no real instance: with no
    data it simply reports insufficient data, which is enough to create, read, update, and
    delete it alongside the dashboard.
    '''

  imports: { aws-cloudwatch: 'github.com/cloudboss/unobin-library-aws//service/cloudwatch' }

  library-configs: { aws-cloudwatch: input.aws-config }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    threshold: {
      type:        number
      default:     80
      description: 'Alarm threshold in percent; the update pass changes it'
    }
    dashboard-body: {
      type: opaque
      default: {
        widgets: [{
          type:       'text'
          x:          0
          y:          0
          width:      6
          height:     3
          properties: { markdown: 'initial' }
        }]
      }
    }
    dashboard-tags: {
      type: map(string)
      default: {
        empty-create: ''
        empty-update: 'set'
        env:          'initial'
        remove:       'yes'
      }
    }
  }

  resources: {
    cloudwatch-metric-alarm-it: aws-cloudwatch.metric-alarm {
      alarm-name:          'unobin-it-alarm'
      alarm-description:   'unobin integration test alarm'
      comparison-operator: 'GreaterThanThreshold'
      evaluation-periods:  2
      metric-name:         'CPUUtilization'
      namespace:           'AWS/EC2'
      period:              300
      statistic:           'Average'
      threshold:           input.threshold
      treat-missing-data:  'missing'
      dimensions:          { InstanceId: 'i-0123456789abcdef0' }
      tags:                { unobin: 'cloudwatch-it' }
    }
    cloudwatch-dashboard-it: aws-cloudwatch.dashboard {
      name: 'unobin-it-dashboard'
      body: @core.to-json(input.dashboard-body)
      tags: input.dashboard-tags
    }
  }

  outputs: {
    alarm-arn:     { value: resource.cloudwatch-metric-alarm-it.arn }
    dashboard-arn: { value: resource.cloudwatch-dashboard-it.arn }
  }
}
