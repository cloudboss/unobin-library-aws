factory: {
  imports:         { aws-cloudwatch: 'github.com/cloudboss/unobin-library-aws//service/cloudwatch' }
  library-configs: { aws-cloudwatch: input.aws-config }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    rule:    { type: string, default: 'TRUE' }
    enabled: { type: boolean, default: true }
    tags: {
      type:    map(string)
      default: { env: 'initial', remove: 'yes' }
    }
  }

  resources: {
    composite: aws-cloudwatch.composite-alarm {
      alarm-name:      'unobin-it-composite'
      alarm-rule:      input.rule
      actions-enabled: input.enabled
      tags:            input.tags
    }
  }

  outputs: {
    alarm-arn: { value: resource.composite.arn }
  }
}
