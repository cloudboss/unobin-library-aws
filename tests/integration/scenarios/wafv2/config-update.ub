stack: {
  factory: {
    inputs: {
      description:   'updated'
      search-string: '/updated'
      replace-resource-association: true
      replace-web-acl-association:  true
      tags: {
        unobin: 'wafv2-it'
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
    }
  }

  state: local {
    path: '.unobin/state'
  }

  encryption: noop {}
}
