stack: {
  factory: {
    inputs: {
      throughput-mode:            'elastic'
      use-updated-security-group: true
      file-system-tags: {
        Name:  'unobin-it-efs'
        state: 'updated'
        added: 'yes'
      }
    }
  }

  state: local {
    path: '.unobin/state'
  }

  encryption: noop {}
}
