factory: {
  description: '''>-
    Manages an EFS file system, access point, and mount target in a dedicated VPC and subnet.
    The update changes throughput mode, access point tags, and the mount target's security
    group, while the verifier reads EFS and EC2 directly after create, update, and destroy.
    '''

  imports: {
    aws-ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2'
    aws-efs: 'github.com/cloudboss/unobin-library-aws//service/efs'
  }

  library-configs: {
    aws-ec2: input.aws-config
    aws-efs: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    throughput-mode:            { type: string, default: 'bursting' }
    use-updated-security-group: { type: boolean, default: false }
    file-system-tags: {
      type: map(string)
      default: {
        Name:   'unobin-it-efs'
        state:  'initial'
        remove: 'yes'
      }
    }
    access-point-tags: {
      type: map(string)
      default: {
        Name:   'unobin-it-efs-access-point'
        state:  'initial'
        remove: 'yes'
      }
    }
  }

  resources: {
    vpc: aws-ec2.vpc {
      cidr-block: '10.64.0.0/16'
    }
    subnet: aws-ec2.subnet {
      vpc-id:     resource.vpc.vpc-id
      cidr-block: '10.64.1.0/24'
      tags:       { unobin: 'efs-it' }
    }
    mount-target-security-group-initial: aws-ec2.security-group {
      name:        'unobin-it-efs-mount-initial'
      description: 'initial EFS mount target integration test security group'
      vpc-id:      resource.vpc.vpc-id
      tags:        { unobin: 'efs-it' }
    }
    mount-target-security-group-updated: aws-ec2.security-group {
      name:        'unobin-it-efs-mount-updated'
      description: 'updated EFS mount target integration test security group'
      vpc-id:      resource.vpc.vpc-id
      tags:        { unobin: 'efs-it' }
    }
    file-system: aws-efs.file-system {
      throughput-mode: input.throughput-mode
      tags:            input.file-system-tags
    }
    access-point: aws-efs.access-point {
      file-system-id: resource.file-system.file-system-id
      tags:           input.access-point-tags
    }
    mount-target: aws-efs.mount-target {
      file-system-id: resource.file-system.file-system-id
      subnet-id:      resource.subnet.id
      security-groups: if input.use-updated-security-group
        then [resource.mount-target-security-group-updated.id]
        else [resource.mount-target-security-group-initial.id]
    }
  }

  outputs: {
    file-system-id:   { value: resource.file-system.file-system-id }
    dns-name:         { value: resource.file-system.dns-name }
    access-point-id:  { value: resource.access-point.access-point-id }
    access-point-arn: { value: resource.access-point.arn }
    mount-target-id:  { value: resource.mount-target.mount-target-id }
    mount-dns-name:   { value: resource.mount-target.mount-target-dns-name }
    security-groups:  { value: resource.mount-target.security-groups }
  }
}
