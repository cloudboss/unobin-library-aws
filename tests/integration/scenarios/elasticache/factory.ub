factory: {
  description: '''>-
    Manages two ElastiCache subnet groups and one replication group in a VPC. The update changes
    subnet membership, descriptions, tags, and the replication group's total cluster count.
    '''

  imports: {
    aws-ec2:         'github.com/cloudboss/unobin-library-aws//service/ec2'
    aws-elasticache: 'github.com/cloudboss/unobin-library-aws//service/elasticache'
  }

  library-configs: {
    aws-ec2:         input.aws-config
    aws-elasticache: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    description: {
      type:    string
      default: 'initial elasticache subnet group'
    }
    subnet-set: {
      type:    integer
      default: 0
    }
    primary-tags: {
      type: map(string)
      default: {
        change: 'old'
        keep:   '1'
        remove: 'yes'
      }
    }
    clear-tags: {
      type:    map(string)
      default: { clear: 'yes' }
    }
    replication-description: {
      type:    string
      default: 'initial elasticache replication group'
    }
    replication-count: {
      type:    integer
      default: 1
    }
    replication-tags: {
      type: map(string)
      default: {
        change: 'old'
        keep:   '1'
        remove: 'yes'
      }
    }
  }

  data-sources: {
    availability-zones: aws-ec2.availability-zones {
      state: 'available'
    }
  }

  locals: {
    clear-subnet-ids: if input.subnet-set == 0
      then [resource.subnet-a.id, resource.subnet-b.id]
      else [resource.subnet-a.id, resource.subnet-c.id]
  }

  resources: {
    vpc: aws-ec2.vpc {
      cidr-block: '10.72.0.0/16'
    }
    subnet-a: aws-ec2.subnet {
      vpc-id:            resource.vpc.vpc-id
      cidr-block:        '10.72.1.0/24'
      availability-zone: data-source.availability-zones.names[0]
      tags:              { unobin: 'elasticache-it-a' }
    }
    subnet-b: aws-ec2.subnet {
      vpc-id:            resource.vpc.vpc-id
      cidr-block:        '10.72.2.0/24'
      availability-zone: data-source.availability-zones.names[1]
      tags:              { unobin: 'elasticache-it-b' }
    }
    subnet-c: aws-ec2.subnet {
      vpc-id:            resource.vpc.vpc-id
      cidr-block:        '10.72.3.0/24'
      availability-zone: data-source.availability-zones.names[1]
      tags:              { unobin: 'elasticache-it-c' }
    }
    primary: aws-elasticache.subnet-group {
      name:        'unobin-it-cache-primary'
      description: input.description
      subnet-ids:  [resource.subnet-a.id, resource.subnet-b.id]
      tags:        input.primary-tags
    }
    clear: aws-elasticache.subnet-group {
      name:        'UNOBIN-IT-CACHE-CLEAR'
      description: 'tag clearing coverage'
      subnet-ids:  local.clear-subnet-ids
      tags:        input.clear-tags
    }
    replication: aws-elasticache.replication-group {
      replication-group-id: 'UNOBIN-IT-CACHE-RG'
      description:          input.replication-description
      node-type:            'cache.t3.micro'
      num-cache-clusters:   input.replication-count
      subnet-group-name:    resource.primary.name
      tags:                 input.replication-tags
    }
  }

  outputs: {
    primary-name:    { value: resource.primary.name }
    primary-arn:     { value: resource.primary.arn }
    clear-name:      { value: resource.clear.name }
    replication-id:  { value: resource.replication.replication-group-id }
    replication-arn: { value: resource.replication.arn }
  }
}
