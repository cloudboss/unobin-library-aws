stack: {
  factory: {
    inputs: {
      primary-name:                'unobin-it-user-pool-updated'
      primary-tier:               'PLUS'
      allow-admin-create-user-only: true
      primary-tags: {
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
      clear-tags: {}
      client-name:                    'unobin-it-user-pool-client-updated'
      client-auth-session-validity:   10
      client-enable-token-revocation: true
      domain-managed-login-version:   2
    }
  }

  state: local {
    path: '.unobin/state'
  }

  encryption: noop {}
}
