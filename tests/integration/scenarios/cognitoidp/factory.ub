factory: {
  description: '''>-
    Manages two Cognito user pools and one app client. The update changes the
    primary pool and app client in place, and clears all managed tags from the
    second pool.
    '''

  imports: {
    aws-cognitoidp: 'github.com/cloudboss/unobin-library-aws//service/cognitoidp'
  }

  library-configs: {
    aws-cognitoidp: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    primary-name: {
      type:    string
      default: 'unobin-it-user-pool-initial'
    }
    primary-tier: {
      type:    string
      default: 'ESSENTIALS'
    }
    allow-admin-create-user-only: {
      type:    boolean
      default: false
    }
    primary-tags: {
      type: map(string)
      default: {
        change: 'old'
        keep:   '1'
        remove: 'yes'
      }
    }
    clear-tags: {
      type:    map(string)
      default: { clear: 'yes' }
    }
    client-name: {
      type:    string
      default: 'unobin-it-user-pool-client-initial'
    }
    client-auth-session-validity: {
      type:    integer
      default: 5
    }
    client-enable-token-revocation: {
      type:    boolean
      default: false
    }
    domain-managed-login-version: {
      type:    integer
      default: 1
    }
  }

  resources: {
    primary: aws-cognitoidp.user-pool {
      name:           input.primary-name
      user-pool-tier: input.primary-tier
      admin-create-user-config: {
        allow-admin-create-user-only: input.allow-admin-create-user-only
      }
      tags: input.primary-tags
    }
    clear: aws-cognitoidp.user-pool {
      name: 'unobin-it-user-pool-clear'
      tags: input.clear-tags
    }
    primary-client: aws-cognitoidp.user-pool-client {
      user-pool-id:            resource.primary.user-pool-id
      name:                    input.client-name
      generate-secret:         true
      auth-session-validity:   input.client-auth-session-validity
      enable-token-revocation: input.client-enable-token-revocation
    }
    primary-domain: aws-cognitoidp.user-pool-domain {
      domain:                'unobin-it-user-pool-domain'
      user-pool-id:          resource.primary.user-pool-id
      managed-login-version: input.domain-managed-login-version
    }
  }

  outputs: {
    primary-id:     { value: resource.primary.user-pool-id }
    primary-arn:    { value: resource.primary.arn }
    primary-tier:   { value: resource.primary.user-pool-tier }
    clear-id:       { value: resource.clear.user-pool-id }
    clear-arn:      { value: resource.clear.arn }
    clear-tier:     { value: resource.clear.user-pool-tier }
    client-id:     { value: resource.primary-client.id }
    client-name:   { value: resource.primary-client.name }
    client-secret: { value: resource.primary-client.client-secret }
    domain:        { value: resource.primary-domain.domain }
    domain-pool-id: { value: resource.primary-domain.user-pool-id }
  }
}
