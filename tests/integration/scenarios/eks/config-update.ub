stack: {
  factory: {
    inputs: {
      cluster-tags: {
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
      node-group-tags: {
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
      addon-tags: {
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
      fargate-profile-tags: {
        add:    'yes'
        change: 'new'
        keep:   '1'
      }
    }
  }

  state: local {
    path: '.unobin/state'
  }

  encryption: noop {}
}
