factory: {
  imports: { aws-lambda: 'github.com/cloudboss/unobin-library-aws//service/lambda' }
  assets: {
    first:  './_output/first.zip'
    second: './_output/second.zip'
  }
  library-configs: { aws-lambda: {} }
  inputs:          { updated: { type: boolean, default: false } }
  resources: {
    layer: aws-lambda.layer-version {
      layer-name: 'unobin-it-layer-version'
      content:    { zip-file-path: if input.updated then asset.second.path else asset.first.path }
      source-code-hash:         if input.updated then 'second' else 'first'
      compatible-architectures: ['x86_64']
      compatible-runtimes:      ['python3.12']
    }
  }
  outputs: {
    published: {
      value: {
        arn:           resource.layer.layer-version-arn
        layer-arn:     resource.layer.layer-arn
        name:          resource.layer.layer-name
        version:       resource.layer.version
        checksum:      resource.layer.code-sha256
        size:          resource.layer.code-size
        architectures: resource.layer.compatible-architectures
        runtimes:      resource.layer.compatible-runtimes
      }
    }
  }
}
