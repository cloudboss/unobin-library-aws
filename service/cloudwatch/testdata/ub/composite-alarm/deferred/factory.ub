factory: {
  imports: { cloudwatch: 'github.com/cloudboss/unobin-library-aws//service/cloudwatch' }

  inputs: {
    endpoint:  { type: string }
    region:    { type: string }
    seed-name: { type: string }
  }

  library-configs: {
    cloudwatch: {
      region:       input.region
      endpoint-url: input.endpoint
      max-attempts: 1
    }
  }

  resources: {
    seed: cloudwatch.composite-alarm {
      alarm-name: input.seed-name
      alarm-rule: 'TRUE'
    }
    alarm: cloudwatch.composite-alarm {
      alarm-name: @core.lookup(
        {
          'arn:aws:cloudwatch:us-east-1:123456789012:alarm:seed-next':  'next'
          'arn:aws:cloudwatch:us-east-1:123456789012:alarm:seed-empty': ''
        },
        resource.seed.arn,
      )
      alarm-rule: 'TRUE'
    }
  }
}
