      rules: [
        {
          name:      'rule name!'
          action:    { allow: {} }
          statement: { label-match-statement: { key: ':label:', scope: 'LABEL' } }
          visibility-config: {
            cloudwatch-metrics-enabled: false
            metric-name:                'rule'
            sampled-requests-enabled:   false
          }
        },
      ]
    }
    null-priority: aws-wafv2.rule-group {
      capacity: 1
      scope:    'REGIONAL'
