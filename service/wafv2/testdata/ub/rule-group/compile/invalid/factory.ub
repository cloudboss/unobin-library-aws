factory: {
  imports:         { aws-wafv2: 'github.com/cloudboss/unobin-library-aws//service/wafv2' }
  library-configs: { aws-wafv2: {} }
  resources: {
    unsupported-rule-members: aws-wafv2.rule-group {
      capacity: 1
      scope:    'REGIONAL'
      visibility-config: {
        cloudwatch-metrics-enabled: false
        metric-name:                'group'
        sampled-requests-enabled:   false
      }
      tags-all: {}
      rules: [
        {
          name:             'rule name!'
          priority:         0
          challenge-config: {}
          override-action:  { none: {} }
          action:           { allow: {} }
          statement:        { label-match-statement: { key: ':label:', scope: 'LABEL' } }
          visibility-config: {
            cloudwatch-metrics-enabled: false
            metric-name:                'rule'
            sampled-requests-enabled:   false
          }
        },
      ]
    }
    encoded-search: aws-wafv2.rule-group {
      capacity: 1
