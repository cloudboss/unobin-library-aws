factory: {
  imports:         { aws-wafv2: 'github.com/cloudboss/unobin-library-aws//service/wafv2' }
  library-configs: { aws-wafv2: input.aws-config }
  inputs: {
    aws-config:  { type: library-config('github.com/cloudboss/unobin-library-aws//config') }
    capacity:    { type: integer }
    scope:       { type: string }
    name:        { type: optional(string) }
    name-prefix: { type: optional(string) }
    description: { type: optional(string) }
    visibility:  { type: opaque }
    rules:       { type: opaque }
    rules-json:  { type: optional(string) }
    custom-response-bodies: { type: opaque }
    tags:                   { type: optional(map(string)) }
  }
  resources: {
    group: aws-wafv2.rule-group {
      capacity:               input.capacity
      scope:                  input.scope
      name:                   input.name
      name-prefix:            input.name-prefix
      description:            input.description
      visibility-config:      input.visibility
      rules:                  input.rules
      rules-json:             input.rules-json
      custom-response-bodies: input.custom-response-bodies
      tags:                   input.tags
    }
  }
}
