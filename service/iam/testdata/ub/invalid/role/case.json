{
  "name": "compile-iam-role",
  "rootPath": ".",
  "executor": "root",
  "commands": [
    {
      "name": "omitted",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "omitted/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/omitted.stdout",
      "exitCode": 1
    },
    {
      "name": "null",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "null/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/null.stdout",
      "exitCode": 1
    },
    {
      "name": "wrong-type",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "wrong-type/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/wrong-type.stdout",
      "exitCode": 1
    },
    {
      "name": "tags-input",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "tags-input/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/tags-input.stdout",
      "exitCode": 1
    }
  ]
}
