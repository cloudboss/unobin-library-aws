factory: {
  imports:         { iam: 'github.com/cloudboss/unobin-library-aws//service/iam' }
  library-configs: { iam: {} }
  resources: {
    linked: iam.service-linked-role {
      aws-service-name: '.'
      custom-suffix:    ''
      description:      ''
      tags:             { empty: '' }
    }
  }
  outputs: {
    arn:         { value: resource.linked.arn }
    name:        { value: resource.linked.role-name }
    id:          { value: resource.linked.role-id }
    path:        { value: resource.linked.path }
    created:     { value: resource.linked.create-date }
    description: { value: resource.linked.description }
    tags:        { value: resource.linked.tags }
    service:     { value: resource.linked.aws-service-name }
    suffix:      { value: resource.linked.custom-suffix }
  }
}
