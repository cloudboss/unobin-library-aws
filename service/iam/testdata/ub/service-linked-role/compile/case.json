      "exitCode": 1
    },
    {
      "name": "no-dot",
      "args": ["compile", "--format", "json", "-p", "no-dot/factory.ub", "-o", "build-no-dot", "--replace-unobin", "$REPO_ROOT", "--replace-go-module", "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"],
