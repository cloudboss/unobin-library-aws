      "args": ["compile", "--format", "json", "-p", "null/factory.ub", "-o", "build-null", "--replace-unobin", "$REPO_ROOT", "--replace-go-module", "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"],
