      "normalize": "json",
      "stdout": "want/scenario.stdout",
      "exitCode": 0
    },
    {
      "name": "omitted",
      "args": ["compile", "--format", "json", "-p", "omitted/factory.ub", "-o", "build-omitted", "--replace-unobin", "$REPO_ROOT", "--replace-go-module", "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"],
