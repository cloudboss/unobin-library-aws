factory: {
  imports: { codebuild: 'github.com/cloudboss/unobin-library-aws//service/codebuild' }
  library-configs: {
    codebuild: { endpoint-url: input.endpoint, region: 'us-east-1', max-attempts: 1 }
  }
  inputs: {
    endpoint: { type: string }
    project:  { type: string }
    variables: {
      type:    optional(list(object({ name: string, value: string, type: optional(string) })))
      default: null
    }
    version: { type: optional(string), default: null }
    region:  { type: optional(string), default: null }
    trigger: { type: string }
  }
  actions: {
    build: codebuild.start-build {
      @trigger:                       input.trigger
      project-name:                   input.project
      source-version:                 input.version
      environment-variables-override: input.variables
      region:                         input.region
    }
  }
  outputs: { build-id: { value: action.build.build-id } }
}
