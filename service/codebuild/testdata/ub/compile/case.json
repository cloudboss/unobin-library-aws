{
  "name": "compile-codebuild-project",
  "rootPath": ".",
  "executor": "root",
  "cliVersion": "v0.13.0-a.4",
  "commands": [
    {
      "name": "scenario",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "scenario/factory.ub",
        "-o",
        "build-scenario",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/scenario.stdout",
      "exitCode": 0
    },
