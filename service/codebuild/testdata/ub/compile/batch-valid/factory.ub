factory: {
  imports:         { codebuild: 'github.com/cloudboss/unobin-library-aws//service/codebuild' }
  library-configs: { codebuild: {} }
  resources: {
    project: codebuild.project {
      build-batch-config: {
        service-role: ''
        restrictions: {
          compute-types-allowed: [
            'BUILD_GENERAL1_SMALL', 'BUILD_GENERAL1_MEDIUM', 'BUILD_GENERAL1_LARGE',
            'BUILD_GENERAL1_XLARGE', 'BUILD_GENERAL1_2XLARGE', 'BUILD_LAMBDA_1GB',
            'BUILD_LAMBDA_2GB', 'BUILD_LAMBDA_4GB', 'BUILD_LAMBDA_8GB', 'BUILD_LAMBDA_10GB',
            'ATTRIBUTE_BASED_COMPUTE', 'CUSTOM_INSTANCE_TYPE', 'BUILD_GENERAL1_SMALL',
          ]
        }
      }
      auto-retry-limit:       4294967296
      concurrent-build-limit: 4294967296
      name:                   'test'
      service-role:           ''
      artifacts:              { type: 'NO_ARTIFACTS' }
      environment: { compute-type: 'BUILD_GENERAL1_SMALL', image: '', type: 'LINUX_CONTAINER' }
      source:      { type: 'NO_SOURCE', buildspec: ' ' }
    }
  }
}
