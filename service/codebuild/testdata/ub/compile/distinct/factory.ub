factory: {
  imports:         { codebuild: 'github.com/cloudboss/unobin-library-aws//service/codebuild' }
  library-configs: { codebuild: {} }
  resources: {
    project: codebuild.project {
      secondary-artifacts: [
        { type: 'S3', artifact-identifier: 'same', name: '0' },
        { type: 'S3', artifact-identifier: 'same', name: '1' },
        { type: 'S3', artifact-identifier: 'same', name: '2' },
        { type: 'S3', artifact-identifier: 'same', name: '3' },
        { type: 'S3', artifact-identifier: 'same', name: '4' },
        { type: 'S3', artifact-identifier: 'same', name: '5' },
        { type: 'S3', artifact-identifier: 'same', name: '6' },
        { type: 'S3', artifact-identifier: 'same', name: '7' },
        { type: 'S3', artifact-identifier: 'same', name: '8' },
        { type: 'S3', artifact-identifier: 'same', name: '9' },
        { type: 'S3', artifact-identifier: 'same', name: '10' },
        { type: 'S3', artifact-identifier: 'same', name: '11' },
        { type: 'S3', artifact-identifier: 'same', name: '12' },
      ]
      name:         'test'
      service-role: ''
      artifacts:    { type: 'NO_ARTIFACTS' }
      environment:  { compute-type: 'BUILD_GENERAL1_SMALL', image: '', type: 'LINUX_CONTAINER' }
      source:       { type: 'NO_SOURCE', buildspec: ' ' }
    }
  }
}
