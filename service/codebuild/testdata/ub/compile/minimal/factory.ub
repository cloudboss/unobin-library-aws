factory: {
  imports:         { codebuild: 'github.com/cloudboss/unobin-library-aws//service/codebuild' }
  library-configs: { codebuild: {} }
  resources: {
    project: codebuild.project {
      name:         'test'
      service-role: ''
      artifacts:    { type: 'NO_ARTIFACTS' }
      environment:  { compute-type: 'BUILD_GENERAL1_SMALL', image: '', type: 'LINUX_CONTAINER' }
      source:       { type: 'NO_SOURCE', buildspec: ' ' }
    }
  }
}
