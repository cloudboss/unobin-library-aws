factory: {
  imports: { lambda: 'github.com/cloudboss/unobin-library-aws//service/lambda' }
  inputs: {
    endpoint:   { type: string }
    region:     { type: optional(string) }
    name:       { type: string }
    qualifier:  { type: optional(string) }
    event-age:  { type: optional(integer) }
    retries:    { type: integer, default: 2 }
    on-failure: { type: optional(map(string)) }
    on-success: { type: optional(map(string)) }
  }
  library-configs: { lambda: { endpoint-url: input.endpoint, region: input.region } }
  resources: {
    settings: lambda.function-event-invoke-config {
      function-name:                input.name
      qualifier:                    input.qualifier
      maximum-event-age-in-seconds: input.event-age
      maximum-retry-attempts:       input.retries
      destination-config:           { on-failure: input.on-failure, on-success: input.on-success }
    }
  }
}
