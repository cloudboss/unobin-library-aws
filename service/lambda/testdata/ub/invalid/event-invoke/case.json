{
  "name": "compile-event-invoke-config",
  "rootPath": ".",
  "executor": "root",
  "commands": [
    {
      "name": "invalid-literals",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "invalid/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/invalid-literals.stdout",
      "exitCode": 1
    },
    {
      "name": "wrong-type",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "wrong-type/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/wrong-type.stdout",
      "exitCode": 1
    }
  ]
}
