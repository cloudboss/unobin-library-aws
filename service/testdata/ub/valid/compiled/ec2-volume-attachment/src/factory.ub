factory: {
  imports:         { aws-ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2' }
  library-configs: { aws-ec2: {} }
  resources: {
    attachment: aws-ec2.volume-attachment {
      device-name:                    '/dev/sdf'
      instance-id:                    'i-one'
      volume-id:                      'vol-one'
      force-detach:                   true
      skip-destroy:                   null
      stop-instance-before-detaching: false
    }
    empty-attachment: aws-ec2.volume-attachment {
      device-name: ''
      instance-id: ''
      volume-id:   ''
    }
  }
  outputs: {
    device:   { value: resource.attachment.device-name }
    instance: { value: resource.attachment.instance-id }
    volume:   { value: resource.attachment.volume-id }
    region:   { value: resource.attachment.region }
    empty-tuple: {
      value: [
        resource.empty-attachment.device-name,
        resource.empty-attachment.instance-id,
        resource.empty-attachment.volume-id,
        resource.empty-attachment.region,
      ]
    }
  }
}
