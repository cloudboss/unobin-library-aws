{
  "format-version": 2,
  "factory": {
    "name": "lambda-layer-version",
    "version": "v0.0.0",
    "content-revision": "<revision>"
  },
  "stack": "dev",
  "steps": [
    {
      "address": "library-config.lambda",
      "kind": "library-config",
      "decision": "eval",
      "inputs": {
        "region": "us-east-1"
      }
    },
    {
      "address": "resource.local",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "compatible-architectures": [
          "x86_64",
          "arm64",
          "x86_64"
        ],
        "compatible-runtimes": [
          "nodejs",
          "nodejs4.3",
          "nodejs6.10",
          "nodejs8.10",
          "nodejs10.x",
          "nodejs12.x",
          "nodejs14.x",
          "nodejs16.x",
          "nodejs18.x",
          "nodejs20.x",
          "nodejs22.x",
          "nodejs24.x",
          "java8",
          "java8.al2",
          "java11",
          "nodejs"
        ],
        "content": {
          "zip-file-path": "./layer.zip"
        },
        "layer-name": "local",
        "skip-destroy": false
      }
    },
    {
      "address": "output.architectures",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.created-date",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.description",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.layer-arn",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.license",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.name",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.region",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.runtimes",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.sha",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.signing-job",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.signing-profile-version",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.size",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.version",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "output.version-arn",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "resource.pinned",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "compatible-runtimes": [
          "dotnetcore2.1",
          "dotnetcore3.1",
          "dotnet6",
          "dotnet8",
          "dotnet10",
          "nodejs4.3-edge",
          "go1.x",
          "ruby2.5",
          "ruby2.7",
          "ruby3.2",
          "ruby3.3",
          "ruby3.4",
          "ruby4.0",
          "provided",
          "provided.al2"
        ],
        "content": {
          "s3-bucket": "bucket",
          "s3-key": "layer.zip",
          "s3-object-version": "version"
        },
        "layer-name": "pinned",
        "skip-destroy": true,
        "source-code-hash": "opaque"
      }
    },
    {
      "address": "resource.remaining-runtimes",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "compatible-architectures": [],
        "compatible-runtimes": [
          "provided.al2023",
          "java8.al2023",
          "java11.al2023",
          "java17.al2023"
        ],
        "content": {
          "s3-bucket": "bucket",
          "s3-key": "layer.zip",
          "s3-object-version": ""
        },
        "layer-name": "remaining-runtimes",
        "skip-destroy": false
      }
    },
    {
      "address": "resource.unpinned",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "compatible-runtimes": [
          "java17",
          "java21",
          "java25",
          "python2.7",
          "python3.6",
          "python3.7",
          "python3.8",
          "python3.9",
          "python3.10",
          "python3.11",
          "python3.12",
          "python3.13",
          "python3.14",
          "dotnetcore1.0",
          "dotnetcore2.0"
        ],
        "content": {
          "s3-bucket": "bucket",
          "s3-key": "layer.zip"
        },
        "description": "",
        "layer-name": "unpinned",
        "license-info": "",
        "skip-destroy": false
      }
    }
  ]
}
