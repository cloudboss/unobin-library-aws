{
  "format-version": 2,
  "factory": {
    "name": "cloudwatch-composite-alarm",
    "version": "v0.0.0",
    "content-revision": "<revision>"
  },
  "stack": "dev",
  "steps": [
    {
      "address": "library-config.cloudwatch",
      "kind": "library-config",
      "decision": "eval",
      "inputs": {
        "region": "us-east-1"
      }
    },
    {
      "address": "resource.configured",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "actions-enabled": false,
        "actions-suppressor": {
          "alarm": "mute",
          "extension-period": 0,
          "wait-period": 30
        },
        "alarm-actions": [
          "",
          "arn:aws-us-gov:sns:us-gov-west-1:123456789012:operations",
          "arn:aws:automate:us-east-1::ec2:stop",
          "arn:aws:iam::aws-managed:policy/operations",
          "arn:aws:sns:us-east-1:cw1234567890:notify",
          "arn:aws:sns:us-east-1:cw1234567890:notify"
        ],
        "alarm-description": "aggregates member alarms",
        "alarm-name": "aggregate",
        "alarm-rule": "ALARM(\"member\")",
        "insufficient-data-actions": [
          "arn:aws:sns:us-east-1:123456789012:topic"
        ],
        "ok-actions": [],
        "tags": {
          "empty": "",
          "environment": "test"
        }
      }
    },
    {
      "address": "output.contents",
      "kind": "output",
      "decision": "eval"
    },
    {
      "address": "resource.defaults",
      "kind": "resource",
      "decision": "create",
      "inputs": {
        "alarm-name": "standalone",
        "alarm-rule": "TRUE"
      }
    }
  ]
}
