{
  "name": "cloudwatch-composite-alarm",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/cloudwatch-composite-alarm",
  "build": true,
  "commands": [
    {
      "name": "plan",
      "args": ["plan", "-c", "stacks/dev.ub", "-o", "alarm-plan.json"],
      "stdout": "want/plan.stdout",
      "stderr": "want/plan.stderr"
    }
  ],
  "planSummaries": [
    {"path": "alarm-plan.json", "want": "want/plan.json", "includeInputs": true}
  ],
  "deterministic": true
}
