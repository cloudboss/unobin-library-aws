factory: {
  imports: {
    aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront'
  }
  inputs: {
    aws-config: {
      type: library-config('github.com/cloudboss/unobin-library-aws//config')
    }
    name:         { type: string }
    cookie-mode:  { type: string }
    header-mode:  { type: string }
    query-mode:   { type: string }
    items:        { type: list(string) }
    header-items: { type: list(string) }
    query-items:  { type: list(string) }
    comment:      { type: optional(string) }
    gzip:         { type: optional(boolean) }
    brotli:       { type: optional(boolean) }
  }
  library-configs: {
    aws-cloudfront: input.aws-config
  }
  resources: {
    policy: aws-cloudfront.cache-policy {
      name:    input.name
      comment: input.comment
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config: { cookie-behavior: input.cookie-mode, cookies: { items: input.items } }
        headers-config: {
          header-behavior: input.header-mode
          headers:         { items: input.header-items }
        }
        query-strings-config: {
          query-string-behavior: input.query-mode
          query-strings:         { items: input.query-items }
        }
        enable-accept-encoding-gzip:   input.gzip
        enable-accept-encoding-brotli: input.brotli
      }
    }
  }
}
