factory: {
  imports: { aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront' }
  library-configs: {
    aws-cloudfront: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
  }

  resources: {
    missing-name: aws-cloudfront.cache-policy {
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-parameters: aws-cloudfront.cache-policy {
      name: 'example'
    }
    null-name: aws-cloudfront.cache-policy {
      name: null
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    null-parameters: aws-cloudfront.cache-policy {
      name:                                            'example'
      parameters-in-cache-key-and-forwarded-to-origin: null
    }
    bad-type: aws-cloudfront.cache-policy {
      name: 23
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    parameters-list: aws-cloudfront.cache-policy {
      name:                                            'example'
      parameters-in-cache-key-and-forwarded-to-origin: []
    }
    wrong-mode-type: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: false }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    wrong-item-type: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none', headers: { items: [false] } }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    unexpected-region: aws-cloudfront.cache-policy {
      name:   'example'
      region: 'us-west-2'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    unexpected-tags: aws-cloudfront.cache-policy {
      name: 'example'
      tags: {}
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-cookies: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    null-cookies: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       null
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    cookies-list: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       []
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-cookie-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       {}
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    null-cookie-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: null }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-headers: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    null-headers: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       null
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    headers-list: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       []
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-header-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       {}
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    null-header-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: null }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    missing-query-strings: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config: { cookie-behavior: 'none' }
        headers-config: { header-behavior: 'none' }
      }
    }
    null-query-strings: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: null
      }
    }
    query-strings-list: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: []
      }
    }
    missing-query-string-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: {}
      }
    }
    null-query-string-behavior: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: null }
      }
    }
  }
}
