factory: {
  imports: { aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront' }
  library-configs: {
    aws-cloudfront: input.aws-config
  }

  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
  }

  resources: {
    cookie-behavior-empty: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: '' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    cookie-behavior-invalid: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'other' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    cookie-behavior-case: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'None' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    header-behavior-empty: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: '' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    header-behavior-invalid: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'other' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    header-behavior-case: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'None' }
        query-strings-config: { query-string-behavior: 'none' }
      }
    }
    query-string-behavior-empty: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: '' }
      }
    }
    query-string-behavior-invalid: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'other' }
      }
    }
    query-string-behavior-case: aws-cloudfront.cache-policy {
      name: 'example'
      parameters-in-cache-key-and-forwarded-to-origin: {
        cookies-config:       { cookie-behavior: 'none' }
        headers-config:       { header-behavior: 'none' }
        query-strings-config: { query-string-behavior: 'None' }
      }
    }
  }
}
