factory: {
  imports:         { aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront' }
  library-configs: { aws-cloudfront: input.aws-config }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    items: { type: list(string), default: [] }
  }
  resources: {
    cookie-behavior-empty: aws-cloudfront.origin-request-policy {
      name:                 'cookie-behavior-empty'
      cookies-config:       { cookie-behavior: '' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    cookie-behavior-unknown: aws-cloudfront.origin-request-policy {
      name:                 'cookie-behavior-unknown'
      cookies-config:       { cookie-behavior: 'invalid' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    cookie-behavior-case: aws-cloudfront.origin-request-policy {
      name:                 'cookie-behavior-case'
      cookies-config:       { cookie-behavior: 'None' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    header-behavior-empty: aws-cloudfront.origin-request-policy {
      name:                 'header-behavior-empty'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: '' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    header-behavior-unknown: aws-cloudfront.origin-request-policy {
      name:                 'header-behavior-unknown'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'invalid' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    header-behavior-case: aws-cloudfront.origin-request-policy {
      name:                 'header-behavior-case'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'None' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    query-string-behavior-empty: aws-cloudfront.origin-request-policy {
      name:                 'query-string-behavior-empty'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: '' }
    }
    query-string-behavior-unknown: aws-cloudfront.origin-request-policy {
      name:                 'query-string-behavior-unknown'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'invalid' }
    }
    query-string-behavior-case: aws-cloudfront.origin-request-policy {
      name:                 'query-string-behavior-case'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'None' }
    }
    pending-cookie-items: aws-cloudfront.origin-request-policy {
      name:                 'pending-cookie-items'
      cookies-config:       { cookie-behavior: 'None', cookies: { items: input.items } }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    unrelated-pending: aws-cloudfront.origin-request-policy {
      name:                 'unrelated-pending'
      cookies-config:       { cookie-behavior: 'None' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none', query-strings: { items: input.items } }
    }
  }
}
