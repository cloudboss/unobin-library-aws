{
  "name": "compile-cloudfront-origin-request-policy",
  "rootPath": ".",
  "executor": "root",
  "commands": [
    {
      "name": "missing",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "missing/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/missing.stdout",
      "exitCode": 1
    },
    {
      "name": "types",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "types/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/types.stdout",
      "exitCode": 1
    },
    {
      "name": "enums",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "enums/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/enums.stdout",
      "exitCode": 1
    },
    {
      "name": "unknown-fields",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "unknown-fields/factory.ub",
        "-o",
        "build",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/unknown-fields.stdout",
      "exitCode": 1
    }
  ]
}
