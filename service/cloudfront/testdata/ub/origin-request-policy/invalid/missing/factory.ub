factory: {
  imports:         { aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront' }
  library-configs: { aws-cloudfront: input.aws-config }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    items: { type: list(string), default: [] }
  }
  resources: {
    missing-name: aws-cloudfront.origin-request-policy {
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    missing-cookies-config: aws-cloudfront.origin-request-policy {
      name:                 'missing-cookies-config'
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    missing-headers-config: aws-cloudfront.origin-request-policy {
      name:                 'missing-headers-config'
      cookies-config:       { cookie-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    missing-query-strings-config: aws-cloudfront.origin-request-policy {
      name:           'missing-query-strings-config'
      cookies-config: { cookie-behavior: 'none' }
      headers-config: { header-behavior: 'none' }
    }
    missing-cookie-behavior: aws-cloudfront.origin-request-policy {
      name:                 'missing-cookie-behavior'
      cookies-config:       {}
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    missing-header-behavior: aws-cloudfront.origin-request-policy {
      name:                 'missing-header-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       {}
      query-strings-config: { query-string-behavior: 'none' }
    }
    missing-query-string-behavior: aws-cloudfront.origin-request-policy {
      name:                 'missing-query-string-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: {}
    }
  }
}
