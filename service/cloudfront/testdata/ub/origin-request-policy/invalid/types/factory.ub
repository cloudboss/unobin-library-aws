factory: {
  imports:         { aws-cloudfront: 'github.com/cloudboss/unobin-library-aws//service/cloudfront' }
  library-configs: { aws-cloudfront: input.aws-config }
  inputs: {
    aws-config: {
      type:    library-config('github.com/cloudboss/unobin-library-aws//config')
      default: {}
    }
    items: { type: list(string), default: [] }
  }
  resources: {
    null-name: aws-cloudfront.origin-request-policy {
      name:                 null
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    wrong-type-name: aws-cloudfront.origin-request-policy {
      name:                 3
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    null-cookies-config: aws-cloudfront.origin-request-policy {
      name:                 'null-cookies-config'
      cookies-config:       null
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    wrong-type-cookies-config: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-cookies-config'
      cookies-config:       []
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    null-headers-config: aws-cloudfront.origin-request-policy {
      name:                 'null-headers-config'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       null
      query-strings-config: { query-string-behavior: 'none' }
    }
    wrong-type-headers-config: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-headers-config'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       []
      query-strings-config: { query-string-behavior: 'none' }
    }
    null-query-strings-config: aws-cloudfront.origin-request-policy {
      name:                 'null-query-strings-config'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: null
    }
    wrong-type-query-strings-config: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-query-strings-config'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: []
    }
    null-cookie-behavior: aws-cloudfront.origin-request-policy {
      name:                 'null-cookie-behavior'
      cookies-config:       { cookie-behavior: null }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    wrong-type-cookie-behavior: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-cookie-behavior'
      cookies-config:       { cookie-behavior: 3 }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    null-header-behavior: aws-cloudfront.origin-request-policy {
      name:                 'null-header-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: null }
      query-strings-config: { query-string-behavior: 'none' }
    }
    wrong-type-header-behavior: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-header-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 3 }
      query-strings-config: { query-string-behavior: 'none' }
    }
    null-query-string-behavior: aws-cloudfront.origin-request-policy {
      name:                 'null-query-string-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: null }
    }
    wrong-type-query-string-behavior: aws-cloudfront.origin-request-policy {
      name:                 'wrong-type-query-string-behavior'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 3 }
    }
    invalid-cookies: aws-cloudfront.origin-request-policy {
      name:                 'invalid-cookies'
      cookies-config:       { cookie-behavior: 'none', cookies: { items: [false] } }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    list-cookies-config-cookies: aws-cloudfront.origin-request-policy {
      name:                 'list-cookies-config-cookies'
      cookies-config:       { cookie-behavior: 'none', cookies: [] }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none' }
    }
    invalid-headers: aws-cloudfront.origin-request-policy {
      name:                 'invalid-headers'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none', headers: { items: [false] } }
      query-strings-config: { query-string-behavior: 'none' }
    }
    list-headers-config-headers: aws-cloudfront.origin-request-policy {
      name:                 'list-headers-config-headers'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none', headers: [] }
      query-strings-config: { query-string-behavior: 'none' }
    }
    invalid-query-strings: aws-cloudfront.origin-request-policy {
      name:                 'invalid-query-strings'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none', query-strings: { items: [false] } }
    }
    list-query-strings-config-query-strings: aws-cloudfront.origin-request-policy {
      name:                 'list-query-strings-config-query-strings'
      cookies-config:       { cookie-behavior: 'none' }
      headers-config:       { header-behavior: 'none' }
      query-strings-config: { query-string-behavior: 'none', query-strings: [] }
    }
  }
}
