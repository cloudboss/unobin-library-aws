factory: {
  imports:         { aws-ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2' }
  library-configs: { aws-ec2: {} }
  resources: {
    attachment: aws-ec2.volume-attachment {
      device-name: '/dev/sdf'
      instance-id: 'i-one'
      volume-id:   'vol-one'
    }
  }
  outputs: { id: { value: resource.attachment.attachment-id } }
}
