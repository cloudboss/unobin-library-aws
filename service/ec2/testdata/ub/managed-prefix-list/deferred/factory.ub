factory: {
  imports: { ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2' }
  library-configs: {
    ec2: { endpoint-url: input.endpoint, region: input.region, max-attempts: 1 }
  }
  inputs: {
    endpoint: { type: string }
    region:   { type: string, default: 'us-east-1' }
    values:   { type: opaque }
  }
  actions: {
    seed: test.seed {
      echo: input.values
    }
  }
  resources: {
    prefix: ec2.managed-prefix-list {
      address-family: action.seed.value.address-family
      max-entries:    action.seed.value.max-entries
      name:           action.seed.value.name
      entries:        action.seed.value.entries
      tags:           action.seed.value.tags
    }
  }
  outputs: {
    id:       { value: resource.prefix.prefix-list-id }
    arn:      { value: resource.prefix.arn }
    family:   { value: resource.prefix.address-family }
    capacity: { value: resource.prefix.max-entries }
    name:     { value: resource.prefix.name }
    owner:    { value: resource.prefix.owner-id }
    version:  { value: resource.prefix.version }
    region:   { value: resource.prefix.region }
    entries:  { value: resource.prefix.entries }
    tags:     { value: resource.prefix.tags }
  }
}
