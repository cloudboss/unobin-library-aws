factory: {
  imports:         { ec2: 'github.com/cloudboss/unobin-library-aws//service/ec2' }
  library-configs: { ec2: { endpoint-url: input.endpoint, region: 'us-east-1', max-attempts: 1 } }
  inputs: {
    endpoint: { type: string }
    trigger:  { type: string }
  }
  resources: {
    instance: ec2.instance {
      ami:           'ami-0123456789abcdef0'
      instance-type: 't3.micro'
    }
  }
  actions: {
    stop: ec2.stop-instance {
      @trigger:    input.trigger
      instance-id: resource.instance.instance-id
    }
  }
}
