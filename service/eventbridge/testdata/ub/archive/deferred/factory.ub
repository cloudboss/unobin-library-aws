factory: {
  imports:         { eventbridge: 'github.com/cloudboss/unobin-library-aws//service/eventbridge' }
  library-configs: { eventbridge: { endpoint-url: input.endpoint, region: input.region } }
  inputs: {
    endpoint:    { type: string }
    region:      { type: string }
    name:        { type: string }
    source:      { type: string }
    description: { type: string }
    pattern:     { type: string }
    key:         { type: string }
    days:        { type: integer }
    trigger:     { type: string }
  }
  actions: {
    seed: test.seed {
      @trigger: input.trigger
      echo: {
        name:        input.name
        source:      input.source
        description: input.description
        pattern:     input.pattern
        key:         input.key
        days:        input.days
      }
    }
  }
  resources: {
    archive: eventbridge.archive {
      name:               action.seed.value.name
      event-source-arn:   action.seed.value.source
      description:        action.seed.value.description
      event-pattern:      action.seed.value.pattern
      kms-key-identifier: action.seed.value.key
      retention-days:     action.seed.value.days
    }
  }
  outputs: {
    arn:         { value: resource.archive.archive-arn }
    name:        { value: resource.archive.archive-name }
    source:      { value: resource.archive.event-source-arn }
    description: { value: resource.archive.description }
    pattern:     { value: resource.archive.event-pattern }
    key:         { value: resource.archive.kms-key-identifier }
    days:        { value: resource.archive.retention-days }
  }
}
