  outputs: {
    arn:         { value: resource.archive.archive-arn }
    name:        { value: resource.archive.archive-name }
    source:      { value: resource.archive.event-source-arn }
    description: { value: resource.archive.description }
    pattern:     { value: resource.archive.event-pattern }
    key:         { value: resource.archive.kms-key-identifier }
