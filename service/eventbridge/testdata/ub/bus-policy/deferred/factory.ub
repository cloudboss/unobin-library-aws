factory: {
  imports:         { eventbridge: 'github.com/cloudboss/unobin-library-aws//service/eventbridge' }
  library-configs: { eventbridge: { endpoint-url: input.endpoint, region: 'us-east-1' } }
  inputs: {
    endpoint: { type: string }
    bus:      { type: string }
    policy:   { type: string }
    trigger:  { type: string, default: 'first' }
  }
  actions: {
    seed: test.seed {
      @trigger: input.trigger
      echo:     { bus: input.bus, policy: input.policy }
    }
  }
  resources: {
    policy: eventbridge.event-bus-policy {
      event-bus-name: action.seed.value.bus
      policy:         action.seed.value.policy
    }
  }
  outputs: { name: { value: resource.policy.name }, policy: { value: resource.policy.policy } }
}
