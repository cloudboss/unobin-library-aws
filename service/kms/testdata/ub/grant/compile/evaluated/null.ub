stack: {
  factory: {
    pin: { supported-versions: [{ version: 'v0.0.0', content-revision: '__REVISION__' }] }
    inputs: {
      endpoint: '__ENDPOINT__'
      grant: {
        key-id:            null
        grantee-principal: 'lambda.amazonaws.com'
        operations:        ['Encrypt', 'Decrypt']
        grant-tokens:      ['a', 'b']
        retire-on-delete:  false
      }
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
