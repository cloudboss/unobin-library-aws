factory: {
  imports: { aws-eks: 'github.com/cloudboss/unobin-library-aws//service/eks' }
  library-configs: {
    aws-eks: { region: 'us-east-1' }
  }
  data-sources: {
    lookup: aws-eks.cluster {
      name: 'cluster'
    }
  }
  outputs: {
    synthetic-id:  { value: data-source.lookup.id }
    lookup-region: { value: data-source.lookup.region }
  }
}
