{
  "name": "compile-eks-cluster-auth",
  "rootPath": ".",
  "executor": "root",
  "cliVersion": "v0.13.0",
  "commands": [
    {
      "name": "valid",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "valid",
        "-o",
        "build-valid",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/valid.stdout",
      "exitCode": 0
    },
    {
      "name": "missing",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "missing",
        "-o",
        "build-missing",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/missing.stdout",
      "exitCode": 1
    },
    {
      "name": "null",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "null",
        "-o",
        "build-null",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/null.stdout",
      "exitCode": 1
    },
    {
      "name": "wrong-type",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "wrong-type",
        "-o",
        "build-wrong-type",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/wrong-type.stdout",
      "exitCode": 1
    },
    {
      "name": "credentials",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "credentials",
        "-o",
        "build-credentials",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/credentials.stdout",
      "exitCode": 1
    },
    {
      "name": "region-type",
      "args": [
        "compile",
        "--format",
        "json",
        "-p",
        "region-type",
        "-o",
        "build-region-type",
        "--replace-unobin",
        "$REPO_ROOT",
        "--replace-go-module",
        "github.com/cloudboss/unobin-library-aws=$WORKSPACE/modules/local/aws"
      ],
      "normalize": "json",
      "stdout": "want/region-type.stdout",
      "exitCode": 1
    }
  ]
}
