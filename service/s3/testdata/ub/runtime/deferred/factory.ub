factory: {
  imports: { s3: 'github.com/cloudboss/unobin-library-aws//service/s3' }

  inputs: {
    endpoint: { type: string }
    lookup:   { type: optional(string) }
  }

  library-configs: {
    s3: { region: 'us-east-1', endpoint-url: input.endpoint, max-attempts: 1 }
  }

  actions: {
    seed: test.seed {
      name: input.lookup
    }
  }

  data-sources: {
    lookup: s3.bucket {
      bucket: action.seed.value
    }
  }

  resources: {
    consumer: test.value {
      name: data-source.lookup.bucket-domain-name
    }
  }

  outputs: {
    bucket: { value: data-source.lookup.bucket }
    domain: { value: resource.consumer.name }
  }
}
